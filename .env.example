# Copy to .env.local for local development (never commit secrets).
# Client-side public config, not secrets
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only - never use NEXT_PUBLIC_ for these values
SUPABASE_SERVICE_ROLE_KEY=

# Square business account; use SANDBOX first; no live checkout until
# authenticated booking records and signed webhook reconciliation exist.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Dedicated SMS number; sending remains OFF until A2P and consent are ready
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_ENABLED=false

# Google Calendar: server-side OAuth and owner-owned calendar, after review
GOOGLE_CALENDAR_ID=

# Legacy Stripe scaffold is disabled in this branch; never activate for Addison
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional future read-only Dassie monitoring. Off by default.
DASSIE_MONITOR_ENABLED=false
